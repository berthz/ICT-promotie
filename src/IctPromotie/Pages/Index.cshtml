@page
@model IndexModel
@{
    ViewData["Title"] = "Kalender";
    var maand = Model.Overzicht.Kalender.EersteDag;
    var vorige = maand.AddMonths(-1);
    var volgende = maand.AddMonths(1);
}

<div class="row g-4">
    <div class="col-lg-8">
        <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
            <h1 class="h3 mb-0 me-auto text-capitalize">@maand.ToString("MMMM yyyy")</h1>
            <div class="btn-group" role="group" aria-label="Maand kiezen">
                <a class="btn btn-outline-secondary" asp-route-jaar="@vorige.Year" asp-route-maand="@vorige.Month" aria-label="Vorige maand">‹</a>
                <a class="btn btn-outline-secondary" asp-page="/Index">Vandaag</a>
                <a class="btn btn-outline-secondary" asp-route-jaar="@volgende.Year" asp-route-maand="@volgende.Month" aria-label="Volgende maand">›</a>
            </div>
            <a class="btn btn-primary" asp-page="/Activiteiten/Bewerken">+ Activiteit</a>
        </div>
        <partial name="_Kalender" model="Model.Overzicht.Kalender" />
        <div class="d-flex flex-wrap justify-content-between align-items-center mt-2 gap-2">
            <partial name="_Legenda" />
            <span class="small text-body-secondary">Klik op een dag (+) om iets toe te voegen, of op een activiteit om hem te wijzigen.</span>
        </div>
    </div>
    <div class="col-lg-4">
        <partial name="_Zijbalk" model="Model.Overzicht" />
    </div>
</div>
