@page
@model IctPromotie.Pages.Materialen.BewerkenModel
@{
    ViewData["Title"] = Model.Materiaal.Id == 0 ? "Materiaal toevoegen" : "Materiaal wijzigen";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <h1 class="h3 mb-3">@ViewData["Title"]</h1>
        <form method="post" class="blok">
            <input type="hidden" asp-for="Materiaal.Id" />
            <div class="mb-3">
                <label asp-for="Materiaal.Naam" class="form-label"></label>
                <input asp-for="Materiaal.Naam" class="form-control" placeholder="bv. Banner, laptops, folders" autofocus />
                <span asp-validation-for="Materiaal.Naam" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Materiaal.Omschrijving" class="form-label"></label>
                <textarea asp-for="Materiaal.Omschrijving" class="form-control" rows="2"></textarea>
            </div>
            <div class="row g-3 mb-3">
                <div class="col-4">
                    <label asp-for="Materiaal.Aantal" class="form-label"></label>
                    <input asp-for="Materiaal.Aantal" class="form-control" min="0" />
                    <span asp-validation-for="Materiaal.Aantal" class="text-danger small"></span>
                </div>
                <div class="col-8">
                    <label asp-for="Materiaal.Opslaglocatie" class="form-label"></label>
                    <input asp-for="Materiaal.Opslaglocatie" class="form-control" />
                </div>
            </div>
            <button type="submit" class="btn btn-primary">Opslaan</button>
            <a class="btn btn-outline-secondary" asp-page="Index">Annuleren</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
